{
  "mcpServers": {
    "github": {
      "command": "mcp-server-github",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "notebooklm": {
      "command": "notebooklm-mcp",
      "env": {
        "HEADLESS": "true"
      }
    },
    "custom-http": {
      "type": "http",
      "url": "http://host.docker.internal:3000"
    }
  }
}
